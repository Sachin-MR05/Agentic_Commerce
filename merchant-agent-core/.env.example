# LLM Provider — HuggingFace free inference (no API token required).
# Set LLM_API_KEY to a free HuggingFace token (https://huggingface.co/settings/tokens)
# to get higher rate limits; leave it blank for anonymous public access.
LLM_PROVIDER=huggingface
LLM_MODEL=HuggingFaceH4/zephyr-7b-beta
LLM_API_KEY=
LLM_BASE_URL=https://api-inference.huggingface.co
# Optional Gemini fallback while keeping HuggingFace as primary provider.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
GEMINI_FALLBACK_BASE_URL=
# Keep output short to reduce token usage.
LLM_MAX_OUTPUT_TOKENS=64

TOOL_SERVICE_URL=http://localhost:8081

AGENT_MAX_ITERATIONS=10
TOOL_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
